# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser — never put
# service-role keys, database URLs or provider secrets here.

# Backend the same-origin /api/* path is proxied to (server-side rewrite in next.config.mjs)
RMS_API_ORIGIN=https://rms-api.shahzaiibimran.workers.dev
# Leave unset to use the proxy. Set to an absolute URL only if the Worker allows your origin via CORS.
# NEXT_PUBLIC_API_BASE_URL=https://rms-api.shahzaiibimran.workers.dev/api
NEXT_PUBLIC_API_VERSION=1

# Supabase project that issues the JWTs the backend verifies (public anon key, not service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for `pnpm gen:api` (regenerating services/api/generated/schemas.ts) — not used at runtime
DOCS_USERNAME=
DOCS_PASSWORD=
